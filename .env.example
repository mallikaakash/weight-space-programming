# Local orchestrator launcher (scripts/orchestrator/run.mjs). Copy to .env (gitignored)
CURSOR_API_KEY=

# GitHub repo for cloud agent clone (required for npm start)
GITHUB_REPO_URL=
GITHUB_REF=main

# Optional: composer-2.5, auto, etc.
# CURSOR_MODEL=composer-2.5

# Set to 1 to open a PR when the cloud agent finishes
# AUTO_CREATE_PR=0

# Claude Code auth (pick one). Preferred for Pro/Max — from `claude setup-token`:
CLAUDE_CODE_OAUTH_TOKEN=

# Optional fallback — Anthropic Console API key (separate billing from Pro):
# ANTHROPIC_API_KEY=

# Optional override
# SPEC_PATH=docs/SPEC.md
